# FlowForge Test Container
#
# Usage:
#   docker build -t flowforge-test .
#   docker run --rm flowforge-test                    # run all tests
#   docker run --rm flowforge-test dotnet build      # just build
#   docker run --rm flowforge-test dotnet test --filter "AgentsMdMerger"  # specific tests
#   docker run --rm -v $(pwd):/repo flowforge-test  # mount local code for live testing

FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /repo

# Copy only source + tests (skip docs, .git, etc to speed up build)
COPY src/ ./src/
COPY tests/ ./tests/
COPY *.csproj ./

# Build
RUN dotnet build src/FlowForge.Installer/FlowForge.Installer.csproj -c Release --verbosity quiet

# Default: run all tests
CMD ["dotnet", "test", "tests/FlowForge.Installer.Tests/FlowForge.Installer.Tests.csproj", "--no-build", "-c", "Release"]
